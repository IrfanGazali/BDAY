<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A Little Birthday Invitation 💌</title>
<style>
  :root{
    --bg:#fff7f3;
    --paper:#fffdfb;
    --ink:#382b2b;
    --muted:#8a7470;
    --accent:#d96b86;
    --accent2:#f2b5c3;
    --gold:#d6a85f;
  }
  *{box-sizing:border-box}
  body{
    margin:0; min-height:100vh; overflow:hidden;
    display:flex; align-items:center; justify-content:center;
    font-family: Georgia, "Times New Roman", serif;
    color:var(--ink);
    background:
      radial-gradient(circle at 15% 15%, #ffe2e9 0 7%, transparent 8%),
      radial-gradient(circle at 85% 80%, #ffe8d6 0 8%, transparent 9%),
      var(--bg);
  }
  .scene{width:min(92vw,560px); text-align:center; position:relative}
  .intro{transition:.8s ease}
  .eyebrow{letter-spacing:.24em;text-transform:uppercase;font:600 11px Arial,sans-serif;color:var(--muted)}
  h1{font-size:clamp(32px,8vw,54px);font-weight:400;margin:12px 0 8px}
  .hint{font:14px Arial,sans-serif;color:var(--muted);margin:0 0 28px}
  .envelope-wrap{perspective:1000px;cursor:pointer;display:inline-block}
  .envelope{
    width:min(82vw,380px); height:245px; position:relative;
    transform-style:preserve-3d; transition:transform .25s ease;
    filter:drop-shadow(0 18px 24px rgba(86,48,48,.14));
  }
  .envelope:hover{transform:translateY(-5px) rotateX(2deg)}
  .env-body{
    position:absolute;inset:0;background:linear-gradient(145deg,#f6c6d1,#eaa0b5);
    border-radius:8px;overflow:hidden;
  }
  .env-body:before,.env-body:after{
    content:"";position:absolute;bottom:0;width:72%;height:2px;background:rgba(130,58,76,.13)
  }
  .env-body:before{left:-18%;transform:rotate(32deg)}
  .env-body:after{right:-18%;transform:rotate(-32deg)}
  .flap{
    position:absolute;z-index:4;left:0;top:0;width:0;height:0;
    border-left:calc(min(82vw,380px)/2) solid transparent;
    border-right:calc(min(82vw,380px)/2) solid transparent;
    border-top:128px solid #f9d4dc;
    transform-origin:top center; transition:transform 1s cubic-bezier(.2,.8,.2,1);
    filter:drop-shadow(0 1px 1px rgba(100,40,55,.08));
  }
  .letter{
    position:absolute;z-index:3;left:7%;width:86%;height:205px;top:28px;
    background:var(--paper);border-radius:4px;padding:24px 20px;
    box-shadow:0 5px 18px rgba(50,30,30,.12);
    transform:translateY(0);transition:transform 1s cubic-bezier(.2,.8,.2,1);
    display:flex;flex-direction:column;justify-content:center;
  }
  .seal{
    position:absolute;z-index:5;left:50%;top:108px;transform:translateX(-50%);
    width:54px;height:54px;border-radius:50%;background:var(--accent);
    display:grid;place-items:center;color:white;font-size:23px;
    box-shadow:0 4px 10px rgba(120,45,65,.2);transition:.45s ease;
  }
  .envelope.open .flap{transform:rotateX(180deg);z-index:2}
  .envelope.open .letter{transform:translateY(-125px)}
  .envelope.open .seal{opacity:0;transform:translateX(-50%) scale(.6)}
  .details{
    position:absolute;left:50%;top:50%;transform:translate(-50%,70px) scale(.95);
    width:min(92vw,500px);opacity:0;pointer-events:none;
    background:rgba(255,253,251,.96);border:1px solid #f0d9d5;
    border-radius:20px;padding:30px 24px;
    box-shadow:0 22px 60px rgba(80,45,45,.14);
    transition:.9s cubic-bezier(.2,.8,.2,1);
  }
  .details.show{opacity:1;pointer-events:auto;transform:translate(-50%,0) scale(1)}
  .details h2{font-size:38px;font-weight:400;margin:4px 0 6px}
  .details .to{color:var(--accent);font:700 12px Arial,sans-serif;letter-spacing:.2em;text-transform:uppercase}
  .message{font-size:18px;line-height:1.55;margin:20px auto 25px;max-width:390px}
  .info{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:20px 0}
  .card{background:#fff7f5;border-radius:12px;padding:13px}
  .label{font:700 10px Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)}
  .value{font-size:16px;margin-top:5px}
  .rsvp{display:inline-block;border:0;border-radius:999px;padding:13px 24px;
    background:var(--accent);color:white;font:700 13px Arial,sans-serif;cursor:pointer}
  .rsvp:hover{filter:brightness(.96);transform:translateY(-1px)}
  .small{font:11px Arial,sans-serif;color:var(--muted);margin-top:15px}
  canvas{position:fixed;inset:0;pointer-events:none;z-index:20}
  @media(max-width:500px){
    .envelope{height:220px}
    .letter{height:185px}
    .details{top:52%}
    .info{grid-template-columns:1fr}
  }
</style>
</head>
<body>
<canvas id="confetti"></canvas>

<div class="scene">
  <div class="intro" id="intro">
    <div class="eyebrow">A little surprise for you</div>
    <h1>You’re invited 💌</h1>
    <p class="hint">Tap the envelope to open your birthday invitation</p>

    <div class="envelope-wrap" id="envelopeWrap" aria-label="Open invitation">
      <div class="envelope" id="envelope">
        <div class="env-body"></div>
        <div class="letter">
          <div class="eyebrow">Birthday Dinner</div>
          <div style="font-size:28px;margin-top:8px">Just you & me ✨</div>
          <div style="font:12px Arial;color:#9a7d7d;margin-top:10px">A special evening awaits...</div>
        </div>
        <div class="flap"></div>
        <div class="seal">♥</div>
      </div>
    </div>
  </div>

  <section class="details" id="details">
    <div class="to">For one very special person</div>
    <h2>Happy Birthday, <span id="name">ZyZaH</span> ✨</h2>
    <p class="message">
      I’d love to take you out for a birthday dinner.
      No crowd, no big party — just a lovely evening together.
    </p>
    <div class="info">
      <div class="card"><div class="label">Date</div><div class="value">26/9/2026</div></div>
      <div class="card"><div class="label">Time</div><div class="value">Evening</div></div>
      <div class="card"><div class="label">Place</div><div class="value">Penang</div></div>
      <div class="card"><div class="label">Dress</div><div class="value">Come as you are ♡</div></div>
    </div>
    <button class="rsvp" onclick="rsvp()">I’ll be there 💕</button>
    <div class="small">Made especially for you.</div>
  </section>
</div>

<script>
const envelope = document.getElementById('envelope');
const details = document.getElementById('details');
const wrap = document.getElementById('envelopeWrap');
const intro = document.getElementById('intro');
let opened = false;

// Web Audio API Audio Synthesizer
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

function playOpenSound() {
  if (audioCtx.state === 'suspended') audioCtx.resume();
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = 'sine';
  osc.frequency.setValueAtTime(200, audioCtx.currentTime);
  osc.frequency.exponentialRampToValueAtTime(600, audioCtx.currentTime + 0.3);
  gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start();
  osc.stop(audioCtx.currentTime + 0.3);
}

function playRSVPSound() {
  if (audioCtx.state === 'suspended') audioCtx.resume();
  const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6 chime chord
  notes.forEach((freq, index) => {
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'triangle';
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(0.2, audioCtx.currentTime + index * 0.08);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + index * 0.08 + 0.6);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(audioCtx.currentTime + index * 0.08);
    osc.stop(audioCtx.currentTime + index * 0.08 + 0.6);
  });
}

function startBackgroundMusic() {
  if (audioCtx.state === 'suspended') audioCtx.resume();
  const melody = [261.63, 329.63, 392.00, 440.00, 392.00, 329.63]; // Gentle ambient loop
  let noteIndex = 0;
  
  function playNextNote() {
    if (!opened) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.value = melody[noteIndex % melody.length];
    gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 1.2);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 1.2);
    noteIndex++;
    setTimeout(playNextNote, 1400);
  }
  playNextNote();
}

wrap.addEventListener('click', () => {
  if(opened) return;
  opened = true;
  playOpenSound();
  envelope.classList.add('open');
  setTimeout(() => {
    intro.style.opacity = '0';
    intro.style.transform = 'translateY(-35px) scale(.97)';
  }, 700);
  setTimeout(() => {
    details.classList.add('show');
    burstConfetti();
    startBackgroundMusic();
  }, 1050);
});

function rsvp(){
  playRSVPSound();
  burstConfetti();
  const btn = document.querySelector('.rsvp');
  btn.textContent = "Can’t wait! 💗";
  btn.disabled = true;
}

const canvas = document.getElementById('confetti');
const ctx = canvas.getContext('2d');
let pieces = [];
function resize(){canvas.width=innerWidth;canvas.height=innerHeight}
addEventListener('resize',resize); resize();

function burstConfetti(){
  const cx=innerWidth/2, cy=innerHeight*.38;
  for(let i=0;i<150;i++){
    pieces.push({
      x:cx,y:cy,
      vx:(Math.random()-.5)*13,
      vy:Math.random()*-12-3,
      g:.24+Math.random()*.14,
      size:5+Math.random()*7,
      rot:Math.random()*Math.PI,
      vr:(Math.random()-.5)*.25,
      life:100+Math.random()*70
    });
  }
  animate();
}
let animating=false;
function animate(){
  if(animating)return;
  animating=true;
  function frame(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    pieces.forEach(p=>{
      p.x+=p.vx;p.y+=p.vy;p.vy+=p.g;p.rot+=p.vr;p.life--;
      ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot);
      ctx.fillStyle=`hsl(${Math.random()*360},70%,65%)`;
      ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size*.55);
      ctx.restore();
    });
    pieces=pieces.filter(p=>p.life>0 && p.y<canvas.height+20);
    if(pieces.length) requestAnimationFrame(frame);
    else {ctx.clearRect(0,0,canvas.width,canvas.height);animating=false}
  }
  requestAnimationFrame(frame);
}
</script>
</body>
</html>
